{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "(dnf install -y alsa-lib atk at-spi2-atk at-spi2-core cups-libs libdrm libX11 libXcomposite libXdamage libXext libXfixes libXrandr libxcb libxkbcommon mesa-libgbm nspr nss pango || echo 'UYARI: sistem kutuphaneleri kurulamadi, on-render dusebilir') && pnpm install",
  "buildCommand": "PLAYWRIGHT_BROWSERS_PATH=0 pnpm exec playwright install chromium && PLAYWRIGHT_BROWSERS_PATH=0 pnpm build",
  "outputDirectory": "dist",
  "trailingSlash": false,
  "redirects": [
    {"source": "/tr", "destination": "/", "permanent": true},
    {"source": "/tr/hakkimizda", "destination": "/#hakkimizda", "permanent": true},
    {"source": "/tr/iletisim", "destination": "/#iletisim", "permanent": true},
    {"source": "/tr/urunler/valiz", "destination": "/wexta", "permanent": true},
    {"source": "/tr/urunler/oyuncu-koltugu", "destination": "/oxyra", "permanent": true},
    {"source": "/tr/urunler/cantalar", "destination": "/#markalar", "permanent": true},
    {"source": "/tr/urunler/seyahat-aksesuarlari", "destination": "/#markalar", "permanent": true},
    {"source": "/tr/kataloglar", "destination": "/wexta", "permanent": true},
    {"source": "/tr/sayfa/kvkk-ve-aydinlatma-metni", "destination": "/kvkk", "permanent": true},
    {"source": "/tr/sayfa/gizlilik-ve-cerez-politikasi", "destination": "/gizlilik", "permanent": true},
    {"source": "/tr/urun/:slug", "destination": "/#markalar", "permanent": true},
    {"source": "/tr/urunler/:slug", "destination": "/#markalar", "permanent": true},
    {"source": "/tr/sayfa/:slug", "destination": "/", "permanent": true},
    {"source": "/en/content/gdpr-and-clarification-text", "destination": "/en/gdpr", "permanent": true},
    {"source": "/en/content/:slug", "destination": "/en", "permanent": true},
    {"source": "/hakkimizda", "destination": "/#hakkimizda", "permanent": true},
    {"source": "/iletisim", "destination": "/#iletisim", "permanent": true},
    {"source": "/insan-kaynaklari", "destination": "/#iletisim", "permanent": true},
    {"source": "/kataloglar", "destination": "/wexta", "permanent": true},
    {"source": "/hizmetler", "destination": "/", "permanent": true},
    {"source": "/sikca-sorulan-sorular", "destination": "/", "permanent": true},
    {"source": "/bloglar", "destination": "/", "permanent": true},
    {"source": "/haberler", "destination": "/", "permanent": true},
    {"source": "/blog/:slug", "destination": "/", "permanent": true},
    {"source": "/haber/:slug", "destination": "/", "permanent": true},
    {"source": "/sayfa/kvkk-ve-aydinlatma-metni", "destination": "/kvkk", "permanent": true},
    {"source": "/sayfa/gizlilik-ve-cerez-politikasi", "destination": "/gizlilik", "permanent": true},
    {"source": "/sayfa/:slug", "destination": "/", "permanent": true},
    {"source": "/urunler/valiz", "destination": "/wexta", "permanent": true},
    {"source": "/urunler/abs-valizler", "destination": "/wexta", "permanent": true},
    {"source": "/urunler/kumas-valizler", "destination": "/wexta", "permanent": true},
    {"source": "/urunler/polikarbon-pc-valizler", "destination": "/wexta", "permanent": true},
    {"source": "/urunler/polipropilen-pp-valizler", "destination": "/wexta", "permanent": true},
    {"source": "/urunler/cocuk-valizleri", "destination": "/wexta", "permanent": true},
    {"source": "/urunler/seyahat-aksesuarlari", "destination": "/wexta", "permanent": true},
    {"source": "/urunler/oyuncu-koltugu", "destination": "/oxyra", "permanent": true},
    {"source": "/urunler/:slug", "destination": "/#markalar", "permanent": true},
    {"source": "/urunler", "destination": "/#markalar", "permanent": true},
    {"source": "/urun/:slug", "destination": "/#markalar", "permanent": true},
    {"source": "/urun", "destination": "/#markalar", "permanent": true},
    {"source": "/product/:slug", "destination": "/#markalar", "permanent": true},
    {"source": "/en/about-us", "destination": "/en#hakkimizda", "permanent": true},
    {"source": "/en/contact", "destination": "/en#iletisim", "permanent": true},
    {"source": "/en/human-resources", "destination": "/en#iletisim", "permanent": true},
    {"source": "/en/catalogs", "destination": "/en/wexta", "permanent": true},
    {"source": "/en/blogs", "destination": "/en", "permanent": true},
    {"source": "/en/allnews", "destination": "/en", "permanent": true},
    {"source": "/en/services", "destination": "/en", "permanent": true},
    {"source": "/en/blog/:slug", "destination": "/en", "permanent": true},
    {"source": "/en/news/:slug", "destination": "/en", "permanent": true},
    {"source": "/en/products/gaming-chair", "destination": "/en/oxyra", "permanent": true},
    {"source": "/en/products/luggage", "destination": "/en/wexta", "permanent": true},
    {"source": "/en/products/polipropilen-pp-luggages", "destination": "/en/wexta", "permanent": true},
    {"source": "/en/products/travel-accessories", "destination": "/en/wexta", "permanent": true},
    {"source": "/en/products/:slug", "destination": "/en#markalar", "permanent": true},
    {"source": "/en/products", "destination": "/en#markalar", "permanent": true},
    {"source": "/en/product/:slug", "destination": "/en#markalar", "permanent": true},
    {"source": "/tr/:path*", "destination": "/", "permanent": true}
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {"key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains"},
        {"key": "X-Content-Type-Options", "value": "nosniff"},
        {"key": "X-Frame-Options", "value": "SAMEORIGIN"},
        {"key": "Referrer-Policy", "value": "strict-origin-when-cross-origin"},
        {"key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()"}
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {"key": "Cache-Control", "value": "public, max-age=31536000, immutable"}
      ]
    },
    {
      "source": "/(images|logos|fonts|og|files)/(.*)",
      "headers": [
        {"key": "Cache-Control", "value": "public, max-age=604800"}
      ]
    }
  ]
}
