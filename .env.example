# Supabase — admin panelinin metinleri sakladığı proje.
# Değerler: Supabase Dashboard > Project Settings > API
#
# Gerçek değerleri BU DOSYAYA YAZMAYIN. Burası git'e giren şablondur.
# Kendi değerlerinizi .env.local dosyasına koyun; o dosya git'e girmez.
#
# ANON_KEY olarak yeni "publishable" anahtar da (sb_publishable_...) geçerlidir;
# ikisi de tarayıcıya açıktır, yazma izni RLS ile korunur.
# service_role anahtarı ve veritabanı şifresi buraya ASLA yazılmaz.
#
# Bu iki değişken olmadan da site çalışır: metinler koddaki tr.ts/en.ts'ten gelir,
# /admin ise "yapılandırılmamış" uyarısı gösterir.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# İletişim formu — EmailJS (https://dashboard.emailjs.com)
# Üçü de tarayıcıya gömülür, gizli değildir. Kötüye kullanımı EmailJS panelinden
# Account > Security > Allowed origins ile alan adına kısıtlayın.
# Şablon değişkenleri: {{from_name}} {{reply_to}} {{company}} {{message}}
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# Admin panelindeki ziyaret özeti — yalnızca SUNUCU tarafı (api/analytics.ts).
# VITE_ öneki YOK: bu değerler tarayıcıya gitmemeli. Vercel > Settings >
# Environment Variables altına girilir, .env.local'a değil.
#   GOOGLE_SERVICE_ACCOUNT_JSON = servis hesabı JSON anahtarının tamamı, tek satır
#   GA4_PROPERTY_ID             = yalnızca sayı, ör. 493827156
